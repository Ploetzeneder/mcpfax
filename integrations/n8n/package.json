{
  "name": "n8n-nodes-mcpfax",
  "version": "1.0.0",
  "description": "n8n node for mcpfax \u2013 send real faxes worldwide (prepaid, no subscription, PDF send report).",
  "keywords": [
    "n8n-community-node-package",
    "fax",
    "send fax",
    "mcpfax",
    "fax api"
  ],
  "license": "MIT",
  "homepage": "https://mcpfax.de/api.php",
  "author": {
    "name": "PIT Webservices GmbH",
    "email": "support@mcpfax.de"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ploetzeneder/mcpfax.git",
    "directory": "integrations/n8n"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');for(const d of ['nodes/Mcpfax','credentials'])for(const f of fs.readdirSync(d))if(f.endsWith('.svg'))fs.copyFileSync(d+'/'+f,'dist/'+d+'/'+f)\"",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/McpfaxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Mcpfax/Mcpfax.node.js",
      "dist/nodes/Mcpfax/McpfaxTrigger.node.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "*",
    "typescript": "~5.6.0",
    "@types/node": "^20.17.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
